# Copy this file to .env and fill in your real values
# NEVER commit your actual .env file to GitHub

# Your MongoDB connection string.
# Easiest option: create a free cluster at https://www.mongodb.com/cloud/atlas
# then copy the connection string it gives you.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/artsync

# Any long random string - used to sign JWT tokens
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the backend server will run on
PORT=5000
